# --- Настройки HTTP-сервера ---
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=30s
# Список разрешенных доменов для CORS (например: "http://localhost:3000,https://my-app.com")
HTTP_ALLOWED_ORIGINS=

# --- Настройки базы данных PostgreSQL ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_TIMEOUT=5s

# --- Настройки кэша/хранилища Redis ---
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DATABASE=
REDIS_TIMEOUT=5s

# --- Настройки логирования ---
LOGGER_LEVEL=DEBUG
# Переменная обязательная если запускать без Makefile сервис не запуститься
LOGGER_FOLDER=

# --- Системные настройки ---
HTTP_TIMEZONE=UTC